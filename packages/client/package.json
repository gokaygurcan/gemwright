{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@gemwright/client",
  "description": "Independent browser client host for compatible Ultima Online servers",
  "version": "0.8.2",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokaygurcan/gemwright.git",
    "directory": "packages/client"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "start": "bun bundle/server.js",
    "dev": "bun server.ts",
    "build": "rm -rf bundle.next && bun build web/main.ts --outdir bundle.next/public --target browser --minify && bun build server.ts --outdir bundle.next --target bun --minify && bun src/prepare-assets.ts && cp ../../LICENSE ."
  },
  "devDependencies": {
    "@gemwright/common": "workspace:*",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0"
  },
  "exports": {
    "./files": "./files.ts"
  },
  "files": [
    "bundle/",
    "Dockerfile",
    "railway.json",
    ".dockerignore",
    ".railwayignore",
    "files.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "gemwright": {
    "schemaVersion": 1
  }
}
