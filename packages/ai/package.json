{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@gemwright/ai",
  "description": "Independent ServUO resident runtime",
  "version": "0.11.0",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokaygurcan/gemwright.git",
    "directory": "packages/ai"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "start": "bun dist/serve.js",
    "dev": "bun --watch src/serve.ts",
    "build": "rm -rf dist && bun build src/index.ts src/serve.ts src/report.ts src/progress-report.ts src/load-test.ts src/persistence-worker.ts src/life-journal-worker.ts src/path-worker.ts --outdir dist --target bun && cp ../../LICENSE ."
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@gemwright/common": "workspace:*",
    "@gemwright/network": "workspace:*",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@typesafe-ai/sdk": "0.7.0"
  },
  "files": [
    "dist/",
    "catalogs/",
    "templates/",
    "world/",
    "tuning.json",
    "start.sh",
    "Dockerfile",
    "railway.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "gemwright": {
    "schemaVersion": 1
  }
}
