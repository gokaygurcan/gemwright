diff --git i/Server/GemwrightHosting.cs w/Server/GemwrightHosting.cs
new file mode 100644
index 0000000..0503d07
--- /dev/null
+++ w/Server/GemwrightHosting.cs
@@ -0,0 +1,52 @@
+using System;
+using System.IO;
+using System.Net;
+using System.Net.Sockets;
+
+namespace Server
+{
+    public static class GemwrightHosting
+    {
+        public static readonly string ShutdownFile = Environment.GetEnvironmentVariable("GEMWRIGHT_SHUTDOWN_FILE");
+        public static readonly IPEndPoint PublicEndpoint = ResolvePublic();
+        public static volatile bool SaveCompleted;
+        private static bool requested;
+
+        private static IPEndPoint ResolvePublic()
+        {
+            var hostname = Environment.GetEnvironmentVariable("RAILWAY_TCP_PROXY_DOMAIN");
+            if (String.IsNullOrEmpty(hostname)) return null;
+            int port;
+            if (!Int32.TryParse(Environment.GetEnvironmentVariable("RAILWAY_TCP_PROXY_PORT"), out port) || port < 1 || port > 65535)
+                throw new ArgumentException("Invalid public TCP proxy port.");
+            foreach (var address in Dns.GetHostAddresses(hostname))
+                if (address.AddressFamily == AddressFamily.InterNetwork) return new IPEndPoint(address, port);
+            throw new ArgumentException("Public TCP proxy has no IPv4 address.");
+        }
+
+        public static bool IsProxy(IPAddress address)
+        {
+            if (PublicEndpoint == null || address.AddressFamily != AddressFamily.InterNetwork) return false;
+            var bytes = address.GetAddressBytes();
+            return bytes[0] == 100 && bytes[1] >= 64 && bytes[1] <= 127;
+        }
+
+        public static void Poll()
+        {
+            if (String.IsNullOrEmpty(ShutdownFile) || !File.Exists(ShutdownFile)) return;
+            if (World.Saving) return;
+            try
+            {
+                World.Save(false, false);
+                World.WaitForWriteCompletion();
+                File.Delete(ShutdownFile);
+                Environment.Exit(0);
+            }
+            catch (Exception error)
+            {
+                Console.Error.WriteLine("Shutdown save failed: " + error);
+                Environment.Exit(1);
+            }
+        }
+    }
+}
