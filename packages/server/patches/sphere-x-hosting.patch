diff --git i/src/game/HostingOptions.h w/src/game/HostingOptions.h
new file mode 100644
index 0000000..e8106e9
--- /dev/null
+++ w/src/game/HostingOptions.h
@@ -0,0 +1,101 @@
+#ifndef GEMWRIGHT_HOSTING_OPTIONS_H
+#define GEMWRIGHT_HOSTING_OPTIONS_H
+#include "../network/CSocket.h"
+#include <cstdlib>
+#include <filesystem>
+#include <stdexcept>
+#include <string>
+
+namespace Gemwright
+{
+    inline bool MysqlFromEnv = false;
+    inline unsigned int MysqlPort = 3306;
+
+    inline const char *MysqlValue(const char *name)
+    {
+        const char *value = std::getenv(name);
+        if (!value || !value[0]) throw std::invalid_argument(std::string("Missing MySQL environment variable: ") + name);
+        return value;
+    }
+
+    inline bool HasPublic = false;
+    inline bool HasListener = false;
+    inline bool RailwayProxy = false;
+    inline bool ShutdownSucceeded = false;
+    inline CSocketAddress PublicEndpoint;
+    inline CSocketAddress Listener;
+    inline std::string ShutdownFile;
+
+    inline CSocketAddress ParseEndpoint(const std::string &value)
+    {
+        const auto separator = value.rfind(':');
+        if (separator == std::string::npos || separator == 0)
+            throw std::invalid_argument("Expected an IPv4 hostname or address followed by :port.");
+        const auto portString = value.substr(separator + 1);
+        if (portString.empty() || portString.find_first_not_of("0123456789") != std::string::npos)
+            throw std::invalid_argument("Endpoint port must be an integer from 1 to 65535.");
+        const auto port = std::stoul(portString);
+        if (port == 0 || port > 65535)
+            throw std::invalid_argument("Endpoint port must be from 1 to 65535.");
+        addrinfo hints = {}, *result = nullptr;
+        hints.ai_family = AF_INET;
+        hints.ai_socktype = SOCK_STREAM;
+        if (getaddrinfo(value.substr(0, separator).c_str(), nullptr, &hints, &result) != 0 || !result)
+            throw std::invalid_argument("Could not resolve endpoint IPv4 address.");
+        CSocketAddress endpoint;
+        endpoint.SetAddrIP(reinterpret_cast<sockaddr_in *>(result->ai_addr)->sin_addr.s_addr);
+        endpoint.SetPort(static_cast<word>(port));
+        freeaddrinfo(result);
+        return endpoint;
+    }
+
+    inline bool Parse(int argc, char **argv)
+    {
+        for (int index = 1; index < argc; ++index)
+        {
+            const std::string option(argv[index]);
+            if (option == "--help")
+            {
+                std::puts("--mysql-env         Read MySQL connection details from MYSQL* environment variables.");
+                std::puts("--listen host:port  Bind without changing shard config.");
+                std::puts("--public host:port  Advertise the public login relay endpoint.");
+                std::puts("--railway-proxy     Exempt shared proxy peers from per-IP limits.");
+                std::puts("--shutdown-file path  Save and exit when this marker appears.");
+                return false;
+            }
+            if (option == "--mysql-env")
+            {
+                for (const auto name : {"MYSQLHOST", "MYSQLUSER", "MYSQLPASSWORD", "MYSQLDATABASE"}) MysqlValue(name);
+                const std::string port = MysqlValue("MYSQLPORT");
+                if (port.find_first_not_of("0123456789") != std::string::npos)
+                    throw std::invalid_argument("MySQL port must be an integer from 1 to 65535.");
+                const auto number = std::stoul(port);
+                if (number == 0 || number > 65535) throw std::invalid_argument("MySQL port must be from 1 to 65535.");
+                MysqlPort = static_cast<unsigned int>(number);
+                MysqlFromEnv = true;
+                continue;
+            }
+            if (option == "--railway-proxy") { RailwayProxy = true; continue; }
+            if (option != "--listen" && option != "--public" && option != "--shutdown-file")
+                throw std::invalid_argument("Unknown launch option: " + option);
+            if (++index >= argc || !argv[index][0] || argv[index][0] == '-')
+                throw std::invalid_argument("Missing value for " + option);
+            if (option == "--public") { PublicEndpoint = ParseEndpoint(argv[index]); HasPublic = true; }
+            else if (option == "--listen") { Listener = ParseEndpoint(argv[index]); HasListener = true; }
+            else
+            {
+                ShutdownFile = argv[index];
+                const auto path = std::filesystem::path(ShutdownFile);
+                if (!path.is_absolute() || !std::filesystem::is_directory(path.parent_path()) || std::filesystem::exists(path))
+                    throw std::invalid_argument("Shutdown marker needs an absolute, unused path in an existing directory.");
+            }
+        }
+        return true;
+    }
+
+    inline bool IsRailwayProxy(const CSocketAddressIP &address)
+    {
+        return RailwayProxy && (ntohl(address.GetAddrIP()) & 0xffc00000U) == 0x64400000U;
+    }
+}
+#endif
