diff --git a/Server/HostingOptions.cs b/Server/HostingOptions.cs
new file mode 100644
index 0000000..489eef1
--- /dev/null
+++ b/Server/HostingOptions.cs
@@ -0,0 +1,89 @@
+using System;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Net;
+using System.Net.Sockets;
+
+namespace Server
+{
+    public static class HostingOptions
+    {
+        public static IPEndPoint PublicEndpoint { get; private set; }
+        public static string ClientDataPath { get; private set; }
+        public static string ShutdownFile { get; private set; }
+        public static bool RailwayProxy { get; private set; }
+
+        public static bool TryParse(string[] args, ref int index)
+        {
+            switch (args[index])
+            {
+                case "--public":
+                    PublicEndpoint = ParsePublicEndpoint(NextValue(args, ref index));
+                    return true;
+                case "--client-data":
+                    ClientDataPath = Path.GetFullPath(NextValue(args, ref index));
+                    if (!Directory.Exists(ClientDataPath))
+                        throw new ArgumentException("Client data directory does not exist: " + ClientDataPath);
+                    return true;
+                case "--shutdown-file":
+                    ShutdownFile = Path.GetFullPath(NextValue(args, ref index));
+                    if (!Directory.Exists(Path.GetDirectoryName(ShutdownFile)) || File.Exists(ShutdownFile))
+                        throw new ArgumentException("Shutdown file requires an existing parent directory and must not already exist.");
+                    return true;
+                case "--railway-proxy":
+                    RailwayProxy = true;
+                    return true;
+                default:
+                    return false;
+            }
+        }
+
+        private static string NextValue(string[] args, ref int index)
+        {
+            var option = args[index];
+            if (++index >= args.Length || String.IsNullOrWhiteSpace(args[index]) || args[index].StartsWith("-"))
+                throw new ArgumentException("Missing value for " + option);
+            return args[index];
+        }
+
+        public static IPEndPoint ParsePublicEndpoint(string value)
+        {
+            var separator = value.LastIndexOf(':');
+            int port;
+            if (separator <= 0 || !Int32.TryParse(value.Substring(separator + 1), NumberStyles.None,
+                    CultureInfo.InvariantCulture, out port) || port < 1 || port > 65535)
+                throw new ArgumentException("--public requires an IPv4 address or hostname followed by :port (1-65535).");
+
+            var host = value.Substring(0, separator);
+            var address = Dns.GetHostAddresses(host).FirstOrDefault(ip => ip.AddressFamily == AddressFamily.InterNetwork);
+            if (address == null)
+                throw new ArgumentException("--public requires a hostname with an IPv4 address.");
+            return new IPEndPoint(address, port);
+        }
+
+        public static bool IsRailwayProxy(IPAddress address)
+        {
+            if (!RailwayProxy || address == null) return false;
+            if (address.IsIPv4MappedToIPv6) address = address.MapToIPv4();
+            if (address.AddressFamily != AddressFamily.InterNetwork) return false;
+            var bytes = address.GetAddressBytes();
+            return bytes[0] == 100 && bytes[1] >= 64 && bytes[1] <= 127;
+        }
+
+        public static void WatchShutdown()
+        {
+            if (ShutdownFile == null) return;
+            Timer.DelayCall(TimeSpan.FromMilliseconds(250), TimeSpan.FromMilliseconds(250), () =>
+            {
+                if (!File.Exists(ShutdownFile)) return;
+                Console.WriteLine("Hosting: Shutdown requested; saving world before exit.");
+                World.WaitForWriteCompletion();
+                World.Save(true, false);
+                World.WaitForWriteCompletion();
+                File.Delete(ShutdownFile);
+                Core.Kill();
+            });
+        }
+    }
+}
