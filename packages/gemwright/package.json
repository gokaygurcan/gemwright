{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "gemwright",
  "description": "Forge your own shard",
  "version": "0.11.0",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokaygurcan/gemwright.git",
    "directory": "packages/gemwright"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "gemwright": "dist/index.js"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node --external @gemwright/cli && cp ../../LICENSE ."
  },
  "dependencies": {
    "@gemwright/cli": "0.11.0"
  },
  "files": [
    "dist/index.js",
    "CHANGELOG.md"
  ]
}
