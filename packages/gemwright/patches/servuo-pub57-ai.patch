+++ b/Server/TrustedHosts.cs
@@ -0,0 +1,54 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Net;
+
+namespace Server
+{
+    // Hosts exempt from per-address account, connection and failed-login limits: Gemwright's AI
+    // residents, which all log in from one service. Names are resolved, not trusted by spelling,
+    // and re-resolved every minute because private-network addresses change on redeploy.
+    public static class TrustedHosts
+    {
+        private static readonly List<string> m_Names = new List<string>();
+        private static readonly object m_Lock = new object();
+        private static HashSet<IPAddress> m_Addresses = new HashSet<IPAddress>();
+        private static DateTime m_ResolvedAt = DateTime.MinValue;
+
+        public static void Add(string name)
+        {
+            if (Uri.CheckHostName(name) != UriHostNameType.Dns)
+                throw new ArgumentException("--trusted-host requires a host name: " + name);
+            lock (m_Lock)
+                m_Names.Add(name);
+        }
+
+        public static bool Contains(IPAddress address)
+        {
+            if (address == null || m_Names.Count == 0) return false;
+            if (address.IsIPv4MappedToIPv6) address = address.MapToIPv4();
+            lock (m_Lock)
+            {
+                if (DateTime.UtcNow - m_ResolvedAt > TimeSpan.FromMinutes(1))
+                {
+                    var resolved = new HashSet<IPAddress>();
+                    foreach (var name in m_Names)
+                    {
+                        try
+                        {
+                            foreach (var ip in Dns.GetHostAddresses(name))
+                                resolved.Add(ip.IsIPv4MappedToIPv6 ? ip.MapToIPv4() : ip);
+                        }
+                        catch (Exception e)
+                        {
+                            Console.WriteLine("Hosting: Could not resolve trusted host {0}: {1}", name, e.Message);
+                        }
+                    }
+                    m_Addresses = resolved;
+                    m_ResolvedAt = DateTime.UtcNow;
+                }
+                return m_Addresses.Contains(address);
+            }
+        }
+    }
+}
