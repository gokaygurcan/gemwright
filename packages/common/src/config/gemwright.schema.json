{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gemwright shard configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "id", "timezone", "expansion", "emulator"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[ -~]{1,32}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "adminEmail": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "expansion": {
      "enum": [
        "base",
        "t2a",
        "uor",
        "td",
        "lbr",
        "aos",
        "se",
        "ml",
        "sa",
        "hs",
        "tol",
        "ej"
      ]
    },
    "emulator": {
      "enum": ["servuo", "sphere", "sphere-x", "runuo", "modernuo"]
    },
    "source": {
      "$ref": "#/definitions/source"
    },
    "runuo": {
      "$ref": "#/definitions/dotnet"
    },
    "modernuo": {
      "$ref": "#/definitions/dotnet"
    },
    "servuo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientFiles": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,16}$"
        },
        "autoCreateAccounts": {
          "type": "boolean"
        },
        "accountsPerIp": {
          "type": "integer",
          "minimum": 0
        },
        "globalChat": {
          "type": "boolean"
        },
        "allowedClients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["owner", "autoCreateAccounts"]
    },
    "sphere": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scriptsSource": {
          "$ref": "#/definitions/source"
        },
        "mysql": {
          "type": "boolean"
        },
        "clientFiles": {
          "type": "string"
        },
        "autoCreateAccounts": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,16}$"
        },
        "maps": {
          "enum": ["expansion", "felucca"]
        },
        "mapSize": {
          "enum": ["modern", "legacy"]
        },
        "clientEncryption": {
          "enum": ["encrypted", "both", "unencrypted"]
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "combatFlags": {
              "type": "number"
            },
            "archeryMovementDelay": {
              "type": "number"
            },
            "damageEra": {
              "type": "number"
            },
            "hitChanceEra": {
              "type": "number"
            },
            "speedEra": {
              "type": "number"
            },
            "speedScaleFactor": {
              "type": "number"
            },
            "magicFlags": {
              "type": "number"
            },
            "racialFlags": {
              "type": "number"
            },
            "revealFlags": {
              "type": "number"
            },
            "npcAI": {
              "type": "number"
            }
          },
          "required": [
            "combatFlags",
            "archeryMovementDelay",
            "damageEra",
            "hitChanceEra",
            "speedEra",
            "speedScaleFactor",
            "magicFlags",
            "racialFlags",
            "revealFlags",
            "npcAI"
          ]
        }
      },
      "required": [
        "scriptsSource",
        "autoCreateAccounts",
        "owner",
        "maps",
        "mapSize"
      ]
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "decisions": {
          "enum": ["local", "jev"]
        },
        "speech": {
          "enum": ["authored", "claude"]
        },
        "races": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["human", "elf", "gargoyle"]
          }
        },
        "chaos": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wars": {
          "type": "boolean"
        },
        "cohorts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "professions": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "required": ["count", "professions"]
          }
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "client": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "ai": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "railway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "server": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["project", "environment"]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "aiReady": {
          "type": "boolean"
        }
      },
      "required": ["host", "port"]
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": ["repository", "ref", "revision"]
    },
    "dotnet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientFiles": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,16}$"
        },
        "autoCreateAccounts": {
          "type": "boolean"
        }
      },
      "required": ["owner", "autoCreateAccounts"]
    }
  }
}
