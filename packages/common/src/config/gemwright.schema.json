{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gemwright shard configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "id", "timezone", "expansion", "emulator", "client"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL of this JSON Schema, for editor completion."
    },
    "schemaVersion": {
      "const": 1,
      "description": "Configuration format version. Missing means 1."
    },
    "name": {
      "type": "string",
      "pattern": "^[ -~]{1,32}$",
      "description": "Shard name players see, 1-32 printable ASCII characters."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "The name as a lowercase, hyphenated slug; must match name. Names services, folders and deployments."
    },
    "adminEmail": {
      "type": "string",
      "description": "Support email written into the emulator configuration."
    },
    "url": {
      "type": "string",
      "description": "Support website written into the emulator configuration. Sphere requires it without http(s)://."
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone the shard runs in, e.g. Europe/London."
    },
    "expansion": {
      "enum": [
        "base",
        "t2a",
        "uor",
        "td",
        "lbr",
        "aos",
        "se",
        "ml",
        "sa",
        "hs",
        "tol",
        "ej"
      ],
      "description": "Expansion era the shard plays as, from base (pre-T2A) to ej (Endless Journey)."
    },
    "emulator": {
      "enum": ["servuo", "sphere", "sphere-x", "runuo", "modernuo"],
      "description": "Server emulator the shard runs."
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Client version, four numbers such as 7.0.45.1. AI residents speak it too."
        }
      },
      "required": ["version"],
      "description": "The classic client players connect with."
    },
    "source": {
      "$ref": "#/definitions/source",
      "description": "Emulator source pinned to an exact revision."
    },
    "runuo": {
      "$ref": "#/definitions/dotnet",
      "description": "RunUO settings."
    },
    "modernuo": {
      "$ref": "#/definitions/dotnet",
      "description": "ModernUO settings."
    },
    "servuo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientFiles": {
          "type": "string",
          "description": "Folder with the UO client files; the default for --files."
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,16}$",
          "description": "Owner (administrator) account name, 1-16 letters, digits, _ or -."
        },
        "autoCreateAccounts": {
          "type": "boolean",
          "description": "Whether logging in with a new account name creates the account."
        },
        "accountsPerIp": {
          "type": "integer",
          "minimum": 0,
          "description": "Accounts allowed per IP address; 0 for unlimited."
        },
        "globalChat": {
          "type": "boolean",
          "description": "Whether the global chat system is enabled."
        },
        "allowedClients": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Client kinds allowed to connect: AllowRegular, AllowUOTD, AllowGod and/or AllowEC (Config/Client.cfg)."
        }
      },
      "required": ["owner", "autoCreateAccounts"],
      "description": "ServUO settings."
    },
    "sphere": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scriptsSource": {
          "$ref": "#/definitions/source",
          "description": "Sphere scripts source pinned to an exact revision."
        },
        "mysql": {
          "type": "boolean",
          "description": "Whether Sphere scripts use a MySQL database, added during deployment."
        },
        "clientFiles": {
          "type": "string",
          "description": "Folder with the UO client files; the default for --files."
        },
        "autoCreateAccounts": {
          "type": "boolean",
          "description": "Whether logging in with a new account name creates the account."
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,16}$",
          "description": "Owner (administrator) account name, 1-16 letters, digits, _ or -."
        },
        "maps": {
          "enum": ["expansion", "felucca"],
          "description": "expansion: every map the expansion includes; felucca: Felucca only."
        },
        "mapSize": {
          "enum": ["modern", "legacy"],
          "description": "modern or legacy Felucca/Trammel map size; legacy cannot be used from ML onwards."
        },
        "clientEncryption": {
          "enum": ["encrypted", "both", "unencrypted"],
          "description": "Which clients are accepted: encrypted, unencrypted or both."
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "combatFlags": {
              "type": "number",
              "description": "sphere.ini CombatFlags."
            },
            "archeryMovementDelay": {
              "type": "number",
              "description": "sphere.ini CombatArcheryMovementDelay."
            },
            "damageEra": {
              "type": "number",
              "description": "sphere.ini CombatDamageEra."
            },
            "hitChanceEra": {
              "type": "number",
              "description": "sphere.ini CombatHitChanceEra."
            },
            "speedEra": {
              "type": "number",
              "description": "sphere.ini CombatSpeedEra."
            },
            "speedScaleFactor": {
              "type": "number",
              "description": "sphere.ini SpeedScaleFactor."
            },
            "magicFlags": {
              "type": "number",
              "description": "sphere.ini MagicFlags."
            },
            "racialFlags": {
              "type": "number",
              "description": "sphere.ini RacialFlags."
            },
            "revealFlags": {
              "type": "number",
              "description": "sphere.ini RevealFlags."
            },
            "npcAI": {
              "type": "number",
              "description": "sphere.ini NPCAI."
            }
          },
          "required": [
            "combatFlags",
            "archeryMovementDelay",
            "damageEra",
            "hitChanceEra",
            "speedEra",
            "speedScaleFactor",
            "magicFlags",
            "racialFlags",
            "revealFlags",
            "npcAI"
          ],
          "description": "Classic Sphere combat and rule values written to sphere.ini. Not supported on Sphere-X."
        }
      },
      "required": [
        "scriptsSource",
        "autoCreateAccounts",
        "owner",
        "maps",
        "mapSize"
      ],
      "description": "Sphere and Sphere-X settings."
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Number of AI residents."
        },
        "decisions": {
          "oneOf": [
            {
              "enum": ["local", "jev", "clef"]
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": [
                {
                  "$ref": "#/definitions/decisionLocal"
                }
              ]
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": [
                {
                  "$ref": "#/definitions/decisionRemote"
                },
                {
                  "$ref": "#/definitions/decisionLocal"
                }
              ]
            },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": [
                {
                  "$ref": "#/definitions/decisionRemote"
                },
                {
                  "$ref": "#/definitions/decisionRemote"
                },
                {
                  "$ref": "#/definitions/decisionLocal"
                }
              ]
            }
          ],
          "description": "Who decides what residents do: local, jev, clef, or an ordered provider list ending in local. Earlier providers fall back to later ones."
        },
        "speech": {
          "enum": ["authored", "claude"],
          "description": "authored: written lines; claude: replies in each resident's own voice by Claude (requires ANTHROPIC_API_KEY)."
        },
        "races": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["human", "elf", "gargoyle"]
          },
          "description": "Races new residents are created as; human and elf by default."
        },
        "chaos": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How unpredictable residents are, 0 (always the direct way) to 1; 0.3 by default."
        },
        "wars": {
          "type": "boolean",
          "description": "Whether the Order and Chaos guild alliances go to war with each other. Off by default."
        },
        "cities": {
          "description": "The only cities AI residents go to (shops, banks, healers, moongates and the grounds around them); every city when unset.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Britain",
              "Buccaneer's Den",
              "Cove",
              "Jhelom",
              "Magincia",
              "Minoc",
              "Moonglow",
              "New Haven",
              "Nujel'm",
              "Serpent's Hold",
              "Skara Brae",
              "Trinsic",
              "Vesper",
              "Wind",
              "Yew"
            ]
          }
        },
        "cohorts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "professions": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "required": ["count", "professions"]
          },
          "description": "Residents started in one city, keyed by city, counted within population: { \"New Haven\": { \"count\": 50, \"professions\": { \"miner\": 6 } } }."
        },
        "debug": {
          "type": "boolean",
          "description": "Whether residents emote their current phase above their heads. Off by default."
        }
      },
      "description": "AI residents (ServUO only): how many, how they decide and speak, and where they live."
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "Exact @gemwright/server version."
        },
        "client": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "Exact @gemwright/client version."
        },
        "ai": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "Exact @gemwright/ai version."
        }
      },
      "description": "Exact published component versions selected by gemwright shard update. Unset components use the versions carried by the CLI."
    },
    "railway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Railway project."
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "description": "Railway environment."
        },
        "server": {
          "type": "string",
          "minLength": 1,
          "description": "Existing Railway server service the client and AI connect to."
        }
      },
      "required": ["project", "environment"],
      "description": "Railway project the shard deploys to."
    },
    "target": {
      "enum": ["local", "railway", "vps"],
      "description": "Default deployment target; saved by the last successful deploy."
    },
    "vps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ssh": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.@-]*$",
          "description": "SSH destination: an alias or user@hostname."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "SSH port; the SSH configuration's when unset."
        },
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_/.-]+$",
          "description": "Dedicated deployment directory on the VPS; gemwright/<id> by default."
        },
        "publicHost": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+$",
          "description": "Address native clients connect to."
        },
        "domain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+$",
          "description": "HTTPS hostname of the browser client."
        }
      },
      "required": ["publicHost"],
      "description": "VPS deployment settings."
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$",
          "description": "Server host."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Server port, 2593 by default."
        },
        "aiReady": {
          "type": "boolean",
          "description": "Confirms the external server has the ServUO AI patch, account creation and a trusted AI source."
        }
      },
      "required": ["host", "port"],
      "description": "An existing server the client and AI connect to instead of a server deployed by Gemwright."
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Git repository."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Branch or tag the revision was resolved from."
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$",
          "description": "Full 40-character commit hash."
        }
      },
      "required": ["repository", "ref", "revision"]
    },
    "dotnet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientFiles": {
          "type": "string",
          "description": "Folder with the UO client files; the default for --files."
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,16}$",
          "description": "Owner (administrator) account name, 1-16 letters, digits, _ or -."
        },
        "autoCreateAccounts": {
          "type": "boolean",
          "description": "Whether logging in with a new account name creates the account."
        }
      },
      "required": ["owner", "autoCreateAccounts"]
    },
    "decisionRemote": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model"],
          "properties": {
            "provider": {
              "const": "jev"
            },
            "model": {
              "enum": ["jev-1.13.0", "jev-1.14.0"]
            },
            "credentialEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,79}$",
              "description": "Environment variable holding the provider credential."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model"],
          "properties": {
            "provider": {
              "const": "clef"
            },
            "model": {
              "enum": ["clef", "clef-flash", "clef-omni"]
            },
            "credentialEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,79}$",
              "description": "Environment variable holding the provider credential."
            }
          }
        }
      ]
    },
    "decisionLocal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": {
          "const": "local"
        }
      }
    }
  }
}
