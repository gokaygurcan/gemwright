{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@gemwright/cli",
  "description": "Forge your own shard",
  "version": "0.8.1",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokaygurcan/gemwright.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "gemwright-cli": "dist/index.js"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node --external @clack/prompts --external chalk && bun src/prepare-assets.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "chalk": "6.0.1"
  },
  "devDependencies": {
    "@gemwright/client": "workspace:*",
    "@gemwright/common": "workspace:*",
    "@gemwright/deployment": "workspace:*",
    "@gemwright/server": "workspace:*",
    "@gemwright/ai": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "templates/",
    "patches/",
    "workspace/",
    ".github/small-forge.png",
    "index.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  }
}
