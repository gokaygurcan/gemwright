{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@gemwright/analyze",
  "description": "Shard save analysis and browser",
  "version": "0.8.1",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokaygurcan/gemwright.git",
    "directory": "packages/analyze"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "start": "bun dist/src/serve.js",
    "dev": "bun --watch src/serve.ts",
    "build": "rm -rf dist && bun build src/index.ts src/serve.ts --outdir dist/src --target bun && bun build web/index.html --outdir dist/web --target browser --minify --entry-naming '[name].[ext]' --asset-naming '[name].[ext]' --chunk-naming '[name].[ext]' --public-path /"
  },
  "dependencies": {
    "preact": "11.1.0"
  },
  "devDependencies": {
    "@gemwright/common": "workspace:*",
    "@gemwright/deployment": "workspace:*"
  },
  "files": [
    "dist/"
  ]
}
