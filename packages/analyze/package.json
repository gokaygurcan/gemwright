{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@gemwright/analyze",
  "description": "Shard save analysis and browser",
  "version": "0.9.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokaygurcan/gemwright.git",
    "directory": "packages/analyze"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "start": "bun dist/src/serve.js",
    "dev": "bun --watch src/serve.ts",
    "build": "rm -rf dist && bun build src/index.ts src/serve.ts --outdir dist/src --target bun && bun web/build.ts dist/web"
  },
  "dependencies": {
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@gemwright/common": "workspace:*",
    "@gemwright/deployment": "workspace:*",
    "bun-plugin-tailwind": "0.1.2",
    "tailwindcss": "4.3.3"
  },
  "files": [
    "dist/"
  ]
}
