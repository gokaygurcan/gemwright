{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gemwright",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "gemwright.org",
      "custom_domain": true
    }
  ]
}
