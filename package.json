{
  "name": "@gemwright/workspace",
  "description": "Forge your own shard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokaygurcan/gemwright.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun run packages/gemwright/src/index.ts",
    "format": "biome format --write",
    "typecheck": "bun check",
    "lint": "biome check",
    "test": "bun test",
    "build": "bun run --cwd packages/gemwright build",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
